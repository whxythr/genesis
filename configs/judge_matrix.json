{
  "description": "Documented generator settings (team_config) for every closed-episode scenario of the checks definitions, Block 2. Pass the team_config to judge_adapter.generate_episode(seed, {\"team_config\": ...}, dir) with any seed. Every key is optional and merged over configs/default.json; unknown keys are rejected.",
  "scenarios": {
    "D01": {"what": "clean company, ordinary reconciliation",
            "team_config": {"clean_probability": 1.0}},
    "D02": {"what": "clean, correctly split payments (one invoice paid by several receipts)",
            "team_config": {"clean_probability": 1.0, "payment_mix": {"unpaid": 0.15, "full": 0.25, "split": 0.45, "combined": 0.15}}},
    "D03": {"what": "clean, correct refunds",
            "team_config": {"clean_probability": 1.0, "distractors": {"refunds": [2, 3]}}},
    "D04": {"what": "clean, legitimate recurring amounts (monthly subscriptions)",
            "team_config": {"clean_probability": 1.0, "distractors": {"subscriptions": [3, 3]}}},
    "D05": {"what": "clean, correct FX conversion and late-evening / foreign-offset operations at the period boundary",
            "team_config": {"clean_probability": 1.0, "foreign_share": 0.5, "distractors": {"boundary_timezone": [2, 2]}}},
    "D06": {"what": "duplicate_invoice", "team_config": {"clean_probability": 0.0, "errors": {"duplicate_invoice": {"enabled": true, "count": [1, 1]}, "unapplied_payment": {"enabled": false}, "fx_error": {"enabled": false}, "period_cutoff": {"enabled": false}}, "scenarios": {"partial_fx_payment_at_cutoff": {"enabled": false}, "partially_paid_duplicate": {"enabled": false}}}},
    "D07": {"what": "duplicate_invoice (x2)", "team_config": {"clean_probability": 0.0, "errors": {"duplicate_invoice": {"enabled": true, "count": [2, 2]}, "unapplied_payment": {"enabled": false}, "fx_error": {"enabled": false}, "period_cutoff": {"enabled": false}}, "scenarios": {"partial_fx_payment_at_cutoff": {"enabled": false}, "partially_paid_duplicate": {"enabled": false}}}},
    "D08": {"what": "duplicate_invoice next to legitimate subscriptions", "team_config": {"clean_probability": 0.0, "distractors": {"subscriptions": [3, 3]}, "errors": {"duplicate_invoice": {"enabled": true, "count": [1, 1]}, "unapplied_payment": {"enabled": false}, "fx_error": {"enabled": false}, "period_cutoff": {"enabled": false}}, "scenarios": {"partial_fx_payment_at_cutoff": {"enabled": false}, "partially_paid_duplicate": {"enabled": false}}}},
    "D09": {"what": "unapplied_payment, missing application (invoice_refs = null)", "team_config": {"clean_probability": 0.0, "errors": {"duplicate_invoice": {"enabled": false}, "unapplied_payment": {"enabled": true, "count": [1, 1], "variants": ["null"]}, "fx_error": {"enabled": false}, "period_cutoff": {"enabled": false}}, "scenarios": {"partial_fx_payment_at_cutoff": {"enabled": false}, "partially_paid_duplicate": {"enabled": false}}}},
    "D10": {"what": "unapplied_payment, partial application (one ref amount reduced)", "team_config": {"clean_probability": 0.0, "errors": {"duplicate_invoice": {"enabled": false}, "unapplied_payment": {"enabled": true, "count": [1, 1], "variants": ["partial"]}, "fx_error": {"enabled": false}, "period_cutoff": {"enabled": false}}, "scenarios": {"partial_fx_payment_at_cutoff": {"enabled": false}, "partially_paid_duplicate": {"enabled": false}}}},
    "D11": {"what": "unapplied_payment, partial application (one of several refs dropped, or reduced)", "team_config": {"clean_probability": 0.0, "errors": {"duplicate_invoice": {"enabled": false}, "unapplied_payment": {"enabled": true, "count": [1, 1], "variants": ["drop", "partial"]}, "fx_error": {"enabled": false}, "period_cutoff": {"enabled": false}}, "scenarios": {"partial_fx_payment_at_cutoff": {"enabled": false}, "partially_paid_duplicate": {"enabled": false}}}},
    "D12": {"what": "fx_error, rate of the previous/next day used", "team_config": {"clean_probability": 0.0, "foreign_share": 0.5, "errors": {"duplicate_invoice": {"enabled": false}, "unapplied_payment": {"enabled": false}, "fx_error": {"enabled": true, "count": [1, 1], "variants": ["previous_day", "next_day"]}, "period_cutoff": {"enabled": false}}, "scenarios": {"partial_fx_payment_at_cutoff": {"enabled": false}, "partially_paid_duplicate": {"enabled": false}}}},
    "D13": {"what": "fx_error, UTC date instead of company-timezone date, or a stale (week-old) rate", "team_config": {"clean_probability": 0.0, "foreign_share": 0.5, "errors": {"duplicate_invoice": {"enabled": false}, "unapplied_payment": {"enabled": false}, "fx_error": {"enabled": true, "count": [1, 1], "variants": ["utc_date_instead_of_company_date", "week_old_rate"]}, "period_cutoff": {"enabled": false}}, "scenarios": {"partial_fx_payment_at_cutoff": {"enabled": false}, "partially_paid_duplicate": {"enabled": false}}}},
    "D14": {"what": "period_cutoff", "team_config": {"clean_probability": 0.0, "errors": {"duplicate_invoice": {"enabled": false}, "unapplied_payment": {"enabled": false}, "fx_error": {"enabled": false}, "period_cutoff": {"enabled": true, "count": [1, 1]}}, "scenarios": {"partial_fx_payment_at_cutoff": {"enabled": false}, "partially_paid_duplicate": {"enabled": false}}}},
    "D15": {"what": "period_cutoff (x2, incl. timezone traps when the offset gap allows)", "team_config": {"clean_probability": 0.0, "errors": {"duplicate_invoice": {"enabled": false}, "unapplied_payment": {"enabled": false}, "fx_error": {"enabled": false}, "period_cutoff": {"enabled": true, "count": [2, 2]}}, "scenarios": {"partial_fx_payment_at_cutoff": {"enabled": false}, "partially_paid_duplicate": {"enabled": false}}}},
    "D16": {"what": "interaction 1: partial foreign-currency payment at the period boundary", "team_config": {"clean_probability": 0.0, "errors": {"duplicate_invoice": {"enabled": true, "count": [0, 0]}, "unapplied_payment": {"enabled": true, "count": [0, 0]}, "fx_error": {"enabled": true, "count": [0, 0]}, "period_cutoff": {"enabled": true, "count": [0, 0]}}, "scenarios": {"partial_fx_payment_at_cutoff": {"enabled": true, "probability": 1.0}, "partially_paid_duplicate": {"enabled": false}}}},
    "D17": {"what": "interaction 1 plus one independent error", "team_config": {"clean_probability": 0.0, "errors": {"duplicate_invoice": {"enabled": true, "count": [1, 1]}, "unapplied_payment": {"enabled": true, "count": [0, 0]}, "fx_error": {"enabled": true, "count": [0, 0]}, "period_cutoff": {"enabled": true, "count": [0, 0]}}, "scenarios": {"partial_fx_payment_at_cutoff": {"enabled": true, "probability": 1.0}, "partially_paid_duplicate": {"enabled": false}}}},
    "D18": {"what": "interaction 1 with high foreign share", "team_config": {"clean_probability": 0.0, "foreign_share": 0.6, "errors": {"duplicate_invoice": {"enabled": true, "count": [0, 0]}, "unapplied_payment": {"enabled": true, "count": [0, 0]}, "fx_error": {"enabled": true, "count": [0, 0]}, "period_cutoff": {"enabled": true, "count": [0, 0]}}, "scenarios": {"partial_fx_payment_at_cutoff": {"enabled": true, "probability": 1.0}, "partially_paid_duplicate": {"enabled": false}}}},
    "D19": {"what": "interaction 2: duplicate invoice that is partially paid", "team_config": {"clean_probability": 0.0, "errors": {"duplicate_invoice": {"enabled": true, "count": [0, 0]}, "unapplied_payment": {"enabled": true, "count": [0, 0]}, "fx_error": {"enabled": true, "count": [0, 0]}, "period_cutoff": {"enabled": true, "count": [0, 0]}}, "scenarios": {"partial_fx_payment_at_cutoff": {"enabled": false}, "partially_paid_duplicate": {"enabled": true, "probability": 1.0}}}},
    "D20": {"what": "interaction 2 plus one independent error", "team_config": {"clean_probability": 0.0, "errors": {"duplicate_invoice": {"enabled": true, "count": [0, 0]}, "unapplied_payment": {"enabled": true, "count": [0, 0]}, "fx_error": {"enabled": true, "count": [0, 0]}, "period_cutoff": {"enabled": true, "count": [1, 1]}}, "scenarios": {"partial_fx_payment_at_cutoff": {"enabled": false}, "partially_paid_duplicate": {"enabled": true, "probability": 1.0}}}}
  }
}
