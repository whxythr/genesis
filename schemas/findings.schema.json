{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "findings",
  "description": "Structural limits are exactly the published ones: <= 30 findings, <= 10 evidence_ids per finding (before de-duplication), explanation <= 1000 Unicode code points. Values that are structurally valid but wrong (unknown type, wrong ids, currency or amount) are false positives, not structural errors.",
  "type": "object",
  "required": ["episode_id", "findings"],
  "additionalProperties": false,
  "properties": {
    "episode_id": {"type": "string"},
    "findings": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": ["type", "affected_ids", "claimed_amount_minor", "currency", "evidence_ids"],
        "additionalProperties": false,
        "properties": {
          "type": {"type": "string"},
          "affected_ids": {"type": "array", "items": {"type": "string"}},
          "claimed_amount_minor": {"type": "integer"},
          "currency": {"type": "string"},
          "evidence_ids": {"type": "array", "maxItems": 10, "items": {"type": "string"}},
          "explanation": {"type": "string", "maxLength": 1000}
        }
      }
    }
  }
}
