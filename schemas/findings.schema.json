{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "findings",
  "type": "object",
  "required": ["episode_id", "findings"],
  "additionalProperties": false,
  "properties": {
    "episode_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "findings": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": ["type", "affected_ids", "claimed_amount_minor", "currency", "evidence_ids"],
        "additionalProperties": false,
        "properties": {
          "type": {"type": "string", "minLength": 1, "maxLength": 64},
          "affected_ids": {"type": "array", "minItems": 1, "maxItems": 10,
                           "items": {"type": "string", "minLength": 1, "maxLength": 64}},
          "claimed_amount_minor": {"type": "integer", "minimum": 0, "maximum": 1000000000000000},
          "currency": {"type": "string", "minLength": 3, "maxLength": 8},
          "evidence_ids": {"type": "array", "maxItems": 10,
                           "items": {"type": "string", "minLength": 1, "maxLength": 64}},
          "explanation": {"type": "string", "maxLength": 1000}
        }
      }
    }
  }
}
