{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "truth",
  "type": "object",
  "required": ["schema_version", "episode_id", "issues"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string"},
    "episode_id": {"type": "string"},
    "issues": {
      "type": "array", "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["issue_id", "type", "affected_ids", "expected_amount_minor", "currency", "acceptable_evidence_sets"],
        "additionalProperties": false,
        "properties": {
          "issue_id": {"type": "string"},
          "type": {"type": "string", "enum": ["duplicate_invoice", "unapplied_payment", "fx_error", "period_cutoff"]},
          "affected_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "expected_amount_minor": {"type": "integer", "minimum": 1},
          "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
          "acceptable_evidence_sets": {"type": "array", "minItems": 1,
                                       "items": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "string"}}}
        }
      }
    }
  }
}
